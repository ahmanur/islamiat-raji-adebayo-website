modules = ["nodejs-24", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8082
externalPort = 80

[[ports]]
localPort = 8083
externalPort = 3000

[[ports]]
localPort = 8084
externalPort = 3001

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://gwylwhtlcwwvvynnmxfu.supabase.co"
SUPABASE_URL = "https://gwylwhtlcwwvvynnmxfu.supabase.co"

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]
